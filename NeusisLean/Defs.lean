import Mathlib

/-!
# Neusis Constructibility: Geometric Definitions

This file formalizes planar constructions using a compass, straightedge, and a marked ruler
(point-verging neusis with unit mark distance `1`), starting from the two base points `(0, 0)`
and `(1, 0)` in `ℝ × ℝ` (identified with `ℂ`).

A real number `x : ℝ` is *neusis-constructible* (`NeusisReal x`) if `(x, 0)` is a
neusis-constructible point; a complex number `z : ℂ` is *neusis-constructible* (`NeusisComplex z`)
if `(z.re, z.im)` is a neusis-constructible point.
-/

namespace Neusis

/-- Points in the Euclidean plane `ℝ²`. -/
abbrev Point : Type := ℝ × ℝ

/-- Squared Euclidean distance between two points. -/
def distSq (p q : Point) : ℝ :=
  (p.1 - q.1) ^ 2 + (p.2 - q.2) ^ 2

/-- Three points are collinear. -/
def Collinear3 (p q r : Point) : Prop :=
  (q.1 - p.1) * (r.2 - p.2) = (q.2 - p.2) * (r.1 - p.1)

/-- A constructed geometric curve: either a line through two distinct points,
or a circle with a center and a distinct point on its circumference. -/
inductive Curve : Type where
  | line (A B : Point) (h : A ≠ B) : Curve
  | circle (C Q : Point) (h : C ≠ Q) : Curve

/-- First defining point of a curve (`A` for a line `AB`, center `C` for a circle `(C, Q)`). -/
def Curve.pt1 : Curve → Point
  | Curve.line A _ _ => A
  | Curve.circle C _ _ => C

/-- Second defining point of a curve (`B` for a line `AB`, point `Q` for a circle `(C, Q)`). -/
def Curve.pt2 : Curve → Point
  | Curve.line _ B _ => B
  | Curve.circle _ Q _ => Q

/-- Incidence of a point on a curve. -/
def OnCurve : Curve → Point → Prop
  | Curve.line A B _, X => Collinear3 A B X
  | Curve.circle C Q _, X => distSq C X = distSq C Q

/-- The set of verging solutions `(X, Y)` through pole `P` between curves `γ₁` and `γ₂`
with mark distance `1`. -/
def NeusisSolutions (P : Point) (γ₁ γ₂ : Curve) : Set (Point × Point) :=
  { xy | OnCurve γ₁ xy.1 ∧ OnCurve γ₂ xy.2 ∧ Collinear3 P xy.1 xy.2 ∧ distSq xy.1 xy.2 = 1 }

/-- Inductive definition of points constructible by compass, straightedge, and point-verging
neusis (marked ruler with mark distance `1`), starting from `(0, 0)` and `(1, 0)`.

Non-degeneracy of each intersection / neusis step is expressed intrinsically as finiteness
of the solution set (so degenerate overlapping curves / concentric unit-gap circles are excluded). -/
inductive NeusisPoint : Point → Prop where
  | base0 : NeusisPoint (0, 0)
  | base1 : NeusisPoint (1, 0)
  | inter_ll {A₁ B₁ A₂ B₂ X : Point}
      (hA₁ : NeusisPoint A₁) (hB₁ : NeusisPoint B₁) (hne₁ : A₁ ≠ B₁)
      (hA₂ : NeusisPoint A₂) (hB₂ : NeusisPoint B₂) (hne₂ : A₂ ≠ B₂)
      (hnonpar : (B₁.1 - A₁.1) * (B₂.2 - A₂.2) ≠ (B₁.2 - A₁.2) * (B₂.1 - A₂.1))
      (h₁ : Collinear3 A₁ B₁ X) (h₂ : Collinear3 A₂ B₂ X) :
      NeusisPoint X
  | inter_lc {A B C Q X : Point}
      (hA : NeusisPoint A) (hB : NeusisPoint B) (hne₁ : A ≠ B)
      (hC : NeusisPoint C) (hQ : NeusisPoint Q) (hne₂ : C ≠ Q)
      (h₁ : Collinear3 A B X) (h₂ : distSq C X = distSq C Q) :
      NeusisPoint X
  | inter_cc {C₁ Q₁ C₂ Q₂ X : Point}
      (hC₁ : NeusisPoint C₁) (hQ₁ : NeusisPoint Q₁) (hne₁ : C₁ ≠ Q₁)
      (hC₂ : NeusisPoint C₂) (hQ₂ : NeusisPoint Q₂) (hne₂ : C₂ ≠ Q₂)
      (hdiff : C₁ ≠ C₂)
      (h₁ : distSq C₁ X = distSq C₁ Q₁) (h₂ : distSq C₂ X = distSq C₂ Q₂) :
      NeusisPoint X
  | neusis_left {P X Y : Point} {γ₁ γ₂ : Curve}
      (hP : NeusisPoint P)
      (hγ₁₁ : NeusisPoint γ₁.pt1) (hγ₁₂ : NeusisPoint γ₁.pt2)
      (hγ₂₁ : NeusisPoint γ₂.pt1) (hγ₂₂ : NeusisPoint γ₂.pt2)
      (hfin : (NeusisSolutions P γ₁ γ₂).Finite)
      (hsol : (X, Y) ∈ NeusisSolutions P γ₁ γ₂) :
      NeusisPoint X
  | neusis_right {P X Y : Point} {γ₁ γ₂ : Curve}
      (hP : NeusisPoint P)
      (hγ₁₁ : NeusisPoint γ₁.pt1) (hγ₁₂ : NeusisPoint γ₁.pt2)
      (hγ₂₁ : NeusisPoint γ₂.pt1) (hγ₂₂ : NeusisPoint γ₂.pt2)
      (hfin : (NeusisSolutions P γ₁ γ₂).Finite)
      (hsol : (X, Y) ∈ NeusisSolutions P γ₁ γ₂) :
      NeusisPoint Y

/-- A real number `x` is neusis-constructible if `(x, 0)` is a neusis-constructible point. -/
def NeusisReal (x : ℝ) : Prop := NeusisPoint (x, 0)

/-- A complex number `z` is neusis-constructible if `(z.re, z.im)` is a neusis-constructible point. -/
def NeusisComplex (z : ℂ) : Prop := NeusisPoint (z.re, z.im)

/-- A real number `x` lies in a real degree-≤6 tower over `ℚ`:
there is a finite chain of subfields `ℚ = K₀ ≤ K₁ ≤ ... ≤ Kᵣ` of `ℝ` with `x ∈ Kᵣ`
and each step `[K_{i+1} : K_i] ≤ 6` (equivalently, each step is generated by a root of
a nonzero polynomial of degree `≤ 6` over the previous subfield). -/
inductive InDeg6Tower : Subfield ℝ → Prop where
  | base : InDeg6Tower (⊥ : Subfield ℝ)
  | adjoin {K : Subfield ℝ} {α : ℝ} (hK : InDeg6Tower K)
      (p : Polynomial K) (hp : p ≠ 0) (hdeg : p.natDegree ≤ 6)
      (hroot : Polynomial.aeval α p = 0) :
      InDeg6Tower (Subfield.closure ((K : Set ℝ) ∪ {α}))

/-- A real number lies in a degree-≤6 tower over `ℚ`. -/
def RealInDeg6Tower (x : ℝ) : Prop :=
  ∃ K : Subfield ℝ, InDeg6Tower K ∧ x ∈ K

/-- The regular `n`-gon is neusis-constructible iff `cos(2π/n)` is neusis-constructible
(equivalently `exp(2π i / n)` is neusis-constructible). -/
def RegularPolygonConstructible (n : ℕ) : Prop :=
  NeusisComplex (Complex.exp (2 * Real.pi * Complex.I / n))

end Neusis
